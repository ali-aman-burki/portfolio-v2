---
import { projects } from '../data/projects';
---
<section id="projects">
	<div class="content">
		<h1 class="reveal">Projects</h1>
		<h2 class="description reveal">Some of the projects I have worked on personally as well as for school.</h2>
		<div class="grid">
			{projects.map((p) => (
				<article class="card project reveal">
					<div class="image_container"><img src={`/images/projects/${p.image}`} alt={`${p.name} screenshot`} loading="lazy" /></div>
					<div class="card-header">
						<h2 class="project-name">{p.name}</h2>
						<span class="project-date">{p.year}</span>
					</div>
					<p>{p.description}</p>
					<div class="footer">
						{p.tags.map((t) => <span class="tag">{t}</span>)}
					</div>
					<a href={p.href} class="e_link" target="_blank" rel="noopener noreferrer" aria-label={`Open ${p.name}`}>
						<i class="fa-solid fa-up-right-from-square"></i>
					</a>
				</article>
			))}
		</div>
	</div>
</section>
